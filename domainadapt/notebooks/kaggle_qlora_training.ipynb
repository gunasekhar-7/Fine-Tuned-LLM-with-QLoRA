 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🚀 DomainAdapt: True 4-Bit QLoRA Fine-Tuning on Kaggle GPU (T4)\n",
    "\n",
    "This notebook runs **genuine 4-bit Quantized Low-Rank Adaptation (QLoRA)** using:\n",
    "- **Base Model**: `Qwen/Qwen2.5-1.5B-Instruct` (or `Qwen/Qwen2.5-3B-Instruct`)\n",
    "- **Quantization**: 4-bit NormalFloat (NF4) with Double Quantization (`bitsandbytes`)\n",
    "- **PEFT**: LoRA on all linear layers (`q, k, v, o, gate, up, down`)\n",
    "- **Supervision**: SFT with Prompt Loss Masking (`-100` on user instructions)\n",
    "- **Hardware**: Free Kaggle NVIDIA T4 (16 GB VRAM)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install dependencies\n",
    "!pip install -q -U transformers peft bitsandbytes accelerate datasets\n",
    "\n",
    "import torch\n",
    "print(f\"PyTorch: {torch.__version__}\")\n",
    "print(f\"CUDA Available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"Total VRAM: {torch.cuda.get_device_properties(0).total_memory / 1024**3:.2f} GB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Configure 4-bit NF4 Quantization (True QLoRA)\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training, TaskType\n",
    "\n",
    "MODEL_NAME = \"Qwen/Qwen2.5-1.5B-Instruct\"  # Scales up from 0.5B to 1.5B or 3B\n",
    "\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_use_double_quant=True,\n",
    "    bnb_4bit_compute_dtype=torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16,\n",
    ")\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)\n",
    "if tokenizer.pad_token is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "base_model = AutoModelForCausalLM.from_pretrained(\n",
    "    MODEL_NAME,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    trust_remote_code=True,\n",
    ")\n",
    "\n",
    "base_model = prepare_model_for_kbit_training(base_model)\n",
    "\n",
    "lora_config = LoraConfig(\n",
    "    r=16,\n",
    "    lora_alpha=32,\n",
    "    lora_dropout=0.05,\n",
    "    target_modules=[\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\", \"gate_proj\", \"up_proj\", \"down_proj\"],\n",
    "    task_type=TaskType.CAUSAL_LM,\n",
    ")\n",
    "\n",
    "model = get_peft_model(base_model, lora_config)\n",
    "model.print_trainable_parameters()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Prepare Dataset with Prompt Loss Masking (-100)\n",
    "import json\n",
    "\n",
    "# Sample troubleshooting dataset (Connectivity, Battery, Setup, Audio/Video, Performance)\n",
    "data_samples = [\n",
    "    {\"instruction\": \"Wi-Fi won't connect to network\", \"expected_output\": json.dumps({\"category\": \"connectivity\", \"action\": \"reset_network_stack\", \"parameters\": {\"flush_dns\": True}, \"estimated_time_minutes\": 5})},\n",
    "    {\"instruction\": \"Laptop battery draining quickly\", \"expected_output\": json.dumps({\"category\": \"battery\", \"action\": \"calibrate_battery\", \"parameters\": {\"brightness_level\": 50}, \"estimated_time_minutes\": 15})},\n",
    "    {\"instruction\": \"No sound from external speakers\", \"expected_output\": json.dumps({\"category\": \"audio_video\", \"action\": \"restart_audio_driver\", \"parameters\": {\"channel\": \"stereo\"}, \"estimated_time_minutes\": 4})},\n",
    "    {\"instruction\": \"Computer is running slowly and freezing\", \"expected_output\": json.dumps({\"category\": \"performance\", \"action\": \"purge_temp_cache\", \"parameters\": {\"target\": \"system_temp\"}, \"estimated_time_minutes\": 8})},\n",
    "    {\"instruction\": \"Peripheral USB device not recognized\", \"expected_output\": json.dumps({\"category\": \"setup\", \"action\": \"reinstall_usb_hub\", \"parameters\": {\"port\": \"usb_c\"}, \"estimated_time_minutes\": 6})},\n",
    "]\n",
    "\n",
    "# Tokenize with Prompt Loss Masking\n",
    "def process_sample(example, max_len=256):\n",
    "    prompt_msgs = [{\"role\": \"user\", \"content\": example[\"instruction\"]}]\n",
    "    full_msgs = [{\"role\": \"user\", \"content\": example[\"instruction\"]}, {\"role\": \"assistant\", \"content\": example[\"expected_output\"]}]\n",
    "    \n",
    "    p_ids = tokenizer.apply_chat_template(prompt_msgs, tokenize=True, add_generation_prompt=True, return_tensors=\"pt\")[\"input_ids\"][0]\n",
    "    f_ids = tokenizer.apply_chat_template(full_msgs, tokenize=True, add_generation_prompt=False, return_tensors=\"pt\")[\"input_ids\"][0]\n",
    "    \n",
    "    labels = f_ids.clone()\n",
    "    labels[:min(len(p_ids), len(f_ids))] = -100  # Mask prompt tokens\n",
    "    return {\"input_ids\": f_ids, \"attention_mask\": torch.ones_like(f_ids), \"labels\": labels}\n",
    "\n",
    "train_tensors = [process_sample(s) for s in data_samples * 15]  # Multiplied for training steps\n",
    "print(f\"Prepared {len(train_tensors)} tokenized SFT training samples with loss masking.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Fast GPU Training Loop with bfloat16 / fp16 Mixed Precision\n",
    "from torch.optim import AdamW\n",
    "import time\n",
    "\n",
    "device = \"cuda\"\n",
    "optimizer = AdamW(model.parameters(), lr=3e-4, weight_decay=0.01)\n",
    "epochs = 3\n",
    "batch_size = 2\n",
    "\n",
    "model.train()\n",
    "start_t = time.time()\n",
    "print(\"Starting QLoRA GPU Training...\")\n",
    "\n",
    "for epoch in range(epochs):\n",
    "    total_loss = 0.0\n",
    "    for i in range(0, len(train_tensors), batch_size):\n",
    "        batch = train_tensors[i:i+batch_size]\n",
    "        max_l = max(x[\"input_ids\"].shape[0] for x in batch)\n",
    "        \n",
    "        input_ids = torch.stack([torch.cat([x[\"input_ids\"], torch.full((max_l - x[\"input_ids\"].shape[0],), tokenizer.pad_token_id)]) for x in batch]).to(device)\n",
    "        attention_mask = torch.stack([torch.cat([x[\"attention_mask\"], torch.zeros(max_l - x[\"attention_mask\"].shape[0], dtype=torch.long)]) for x in batch]).to(device)\n",
    "        labels = torch.stack([torch.cat([x[\"labels\"], torch.full((max_l - x[\"labels\"].shape[0],), -100)]) for x in batch]).to(device)\n",
    "        \n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(input_ids=input_ids, attention_mask=attention_mask, labels=labels)\n",
    "        loss = outputs.loss\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        total_loss += loss.item()\n",
    "        \n",
    "    print(f\"Epoch {epoch+1}/{epochs} | Avg Loss: {total_loss / (len(train_tensors) / batch_size):.4f}\")\n",
    "\n",
    "print(f\"Training complete in {time.time() - start_t:.1f}s!\")\n",
    "print(f\"Allocated VRAM: {torch.cuda.memory_allocated() / 1024**2:.1f} MB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Inference & Schema Verification on GPU\n",
    "model.eval()\n",
    "test_prompt = \"Wi-Fi connection keeps dropping every few minutes\"\n",
    "inputs = tokenizer.apply_chat_template([{\"role\": \"user\", \"content\": test_prompt}], add_generation_prompt=True, return_tensors=\"pt\").to(device)\n",
    "\n",
    "t0 = time.time()\n",
    "with torch.no_grad():\n",
    "    out = model.generate(input_ids=inputs[\"input_ids\"], attention_mask=inputs[\"attention_mask\"], max_new_tokens=64, do_sample=False)\n",
    "\n",
    "gen_text = tokenizer.decode(out[0][inputs[\"input_ids\"].shape[1]:], skip_special_tokens=True)\n",
    "print(f\"Inference Latency: {(time.time() - t0)*1000:.1f} ms\")\n",
    "print(\"\\n--- Generated JSON Output ---\")\n",
    "print(gen_text)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. Export Trained QLoRA Adapter\n",
    "OUTPUT_DIR = \"./qlora_adapter_gpu\"\n",
    "model.save_pretrained(OUTPUT_DIR)\n",
    "tokenizer.save_pretrained(OUTPUT_DIR)\n",
    "print(f\"LoRA adapter weights saved to {OUTPUT_DIR}. Download and drop into your local domainadapt/artifacts/trained_adapter!\")"
   ]
  }
 ],
