# DomainAdapt Environment Variables

# Base model and device
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
DEVICE=cpu

# LoRA configuration
LORA_R=8
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Training configuration
TRAINING_EPOCHS=3
TRAINING_BATCH_SIZE=1
TRAINING_GRAD_ACCUM_STEPS=8
LEARNING_RATE=2e-4
WEIGHT_DECAY=0.01
MAX_SEQ_LENGTH=512
SEED=42

# Evaluation configuration
EVAL_METRIC=exact_match
TEST_SAMPLES=100

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100

# Experiment tracking
WANDB_PROJECT=domainadapt
WANDB_RUN_NAME=local-run

# Output constraints
MAX_NEW_TOKENS=128
TEMPERATURE=0.0